set(CMAKE_SYSTEM_NAME FreeBSD)
set(CMAKE_SYSTEM_VERSION 9)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_CROSSCOMPILING TRUE)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES SDK LLVM PH_ENTROPY_OBJECT)
set(SDK "$ENV{PS5_PAYLOAD_SDK}" CACHE PATH "External PS5 homebrew payload SDK")
if(NOT SDK)
  message(FATAL_ERROR "Pass -DSDK=/path/to/external/sdk")
endif()
set(LLVM "C:/Program Files/LLVM/bin" CACHE PATH "LLVM tools")
set(CMAKE_C_COMPILER "${LLVM}/clang.exe")
set(CMAKE_C_COMPILER_TARGET x86_64-sie-ps5)
set(CMAKE_ASM_COMPILER "${LLVM}/clang.exe")
set(CMAKE_AR "${LLVM}/llvm-ar.exe")
set(CMAKE_RANLIB "${LLVM}/llvm-ranlib.exe")
set(CMAKE_SYSROOT "${SDK}")
set(CMAKE_C_FLAGS_INIT "-isystem ${SDK}/target/include -fPIE -DWOLFSSL_USER_SETTINGS -I${CMAKE_CURRENT_LIST_DIR}")
set(CMAKE_FIND_ROOT_PATH "${SDK}/target")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(CMAKE_ASM_COMPILER_TARGET x86_64-sie-ps5)
set(CMAKE_ASM_FLAGS_INIT "-isystem ${SDK}/target/include -fPIE -DWOLFSSL_USER_SETTINGS -I${CMAKE_CURRENT_LIST_DIR}")
set(CMAKE_C_LINK_EXECUTABLE "\"${SDK}/win/prospero-lld.exe\" -m elf_x86_64 -pie --gc-sections -T ${SDK}/ldscripts/elf_x86_64.x -z max-page-size=0x4000 -o <TARGET> ${SDK}/target/lib/crt1.o <OBJECTS> <LINK_LIBRARIES> ${PH_ENTROPY_OBJECT} -L${SDK}/target/lib -lc -lpthread -lSceLibcInternal -lSceNet -lSceNetCtl -lkernel_web")
